#!/usr/bin/env bash
#
# Local fast-fail. Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# CI is the gate (conventions.md §4); this runs what CI runs first and cheapest, so a
# formatting or codegen break is caught before it costs a pipeline round trip. Bypass
# with --no-verify on a WIP branch.
#
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0

echo "pre-push: spotless"
./mvnw -q spotless:check || { echo "  fix with: ./mvnw spotless:apply" >&2; fail=1; }

# buf lint is cheap and catches a malformed proto before protoc does, with a better
# message. buf breaking is left to CI: it needs the master ref to compare against, which
# a local branch may not have fetched.
if command -v buf > /dev/null 2>&1; then
  echo "pre-push: buf lint"
  buf lint || fail=1
else
  echo "pre-push: buf not installed — skipping lint (CI still runs it)"
fi

echo "pre-push: compile + unit tests"
./mvnw -q test || fail=1

exit $fail
